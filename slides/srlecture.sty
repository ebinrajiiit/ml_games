% srlecture.sty -- plain lecture style for QIPPG103 sessions (Sara Renjit, IIIT Kottayam)
% White page, Palatino text, one accent colour. Compiles with pdflatex.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{srlecture}

\RequirePackage[T1]{fontenc}
\RequirePackage[sc]{mathpazo}
\renewcommand{\ttdefault}{lmtt}
\RequirePackage{amsmath,amssymb,bm}
\RequirePackage{booktabs,array,multirow}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds,decorations.pathreplacing,shapes.geometric}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.16}
\RequirePackage{listings}
\RequirePackage{qrcode}
\RequirePackage{xcolor}

% ---------- colours ----------
\definecolor{ink}{HTML}{1E1E1E}
\definecolor{inksoft}{HTML}{5A5A5A}
\definecolor{rulegrey}{HTML}{C8C8C8}
\definecolor{paperwash}{HTML}{F3F3F1}
\definecolor{navy}{HTML}{1F4E79}   % titles, structure
\definecolor{brick}{HTML}{B03A2E}  % emphasis, used sparingly
\definecolor{leaf}{HTML}{2E7D4F}   % "correct" marks
\definecolor{ochre}{HTML}{C08A1E}  % third series in plots
\definecolor{petrol}{HTML}{173F4A} % FACTS-H Lab identity
\definecolor{brass}{HTML}{B0832E}  % FACTS-H Lab identity

\setbeamercolor{normal text}{fg=ink,bg=white}
\setbeamercolor{structure}{fg=navy}
\setbeamercolor{alerted text}{fg=brick}
\setbeamercolor{frametitle}{fg=navy}
\setbeamercolor{title}{fg=ink}
\setbeamercolor{footline}{fg=inksoft}
\setbeamercolor{block title}{fg=navy,bg=}
\setbeamercolor{block body}{fg=ink,bg=}

\usefonttheme{serif}
\setbeamertemplate{navigation symbols}{}
\setbeamerfont{frametitle}{size=\Large}
\setbeamerfont{footline}{size=\scriptsize}

% ---------- frame title: left aligned, hairline below ----------
\newcommand{\lecturelabel}{}
\setbeamertemplate{frametitle}{%
  \vskip0.55em
  \ifx\insertframesubtitle\@empty\else\fi
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
  \vskip0.2em
  {\color{rulegrey}\rule{\textwidth}{0.4pt}}\par
  \ifx\insertframesubtitle\@empty\else
    \vskip0.1em{\small\color{inksoft}\itshape\insertframesubtitle\par}\fi
  \vskip0.1em
}

% ---------- footline ----------
\setbeamertemplate{footline}{%
  \leavevmode
  \hbox to \paperwidth{\hskip1.2em
    {\usebeamerfont{footline}\usebeamercolor[fg]{footline}\lecturelabel\hfill
     \factshsmall\hspace{1.4em}\insertframenumber\,/\,\inserttotalframenumber}\hskip1.2em}%
  \vskip0.7em}

% ---------- lists ----------
\setbeamertemplate{itemize item}{\color{navy}\raisebox{0.15ex}{\textendash}}
\setbeamertemplate{itemize subitem}{\color{inksoft}\raisebox{0.1ex}{\textperiodcentered}}
\setbeamertemplate{enumerate item}{\color{navy}\insertenumlabel.}
\setlength{\leftmargini}{1.1em}

% ---------- blocks: a left rule, no shaded box ----------
\setbeamertemplate{blocks}[default]
\setbeamertemplate{block begin}{%
  \par\vskip0.3em
  \begin{tikzpicture}[baseline=(b.north)]
  \node[inner sep=0pt,anchor=north west,text width=\dimexpr\linewidth-1em\relax] (b) \bgroup
  {\ifx\insertblocktitle\@empty\else{\color{navy}\bfseries\insertblocktitle}\par\vskip0.15em\fi}}
\setbeamertemplate{block end}{%
  \egroup;
  \draw[navy,line width=1.2pt] ([xshift=-0.6em]b.north west) -- ([xshift=-0.6em]b.south west);
  \end{tikzpicture}\par\vskip0.3em}

% ---------- FACTS-H Lab wordmark ----------
\newcommand{\factshfont}{\fontfamily{phv}\selectfont}
% full mark: brass bar + FACTS-H + LAB
\newcommand{\factshmark}[1][1]{%
  \begin{tikzpicture}[baseline=(t.base),scale=#1,every node/.style={transform shape}]
    \fill[brass] (0,-0.08) rectangle (0.12,0.42);
    \node[anchor=west,inner sep=0,text=petrol] (t) at (0.2,0.15) {\factshfont\bfseries\large FACTS-H};
    \node[anchor=west,inner sep=0,text=brass] at ([xshift=0.3em]t.east) {\factshfont\small\scshape lab};
  \end{tikzpicture}}
% tiny version for the footer
\newcommand{\factshsmall}{{\color{brass}\rule[-0.1ex]{0.25em}{1.4ex}}\,{\color{petrol}\factshfont\bfseries FACTS-H}\,{\color{brass}\factshfont Lab}}
\newcommand{\factshurl}{https://factsh.iiitkottayam.ac.in}

% ---------- small helpers ----------
% Activity tag in the top-right corner: \yourturn{3 min}
\newcommand{\yourturn}[1]{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=north east,font=\scriptsize\scshape,text=brick,inner sep=2pt]
      at ([xshift=-1.2em,yshift=-1.0em]current page.north east) {your turn \textperiodcentered\ #1};
  \end{tikzpicture}}
\newcommand{\margin}[1]{{\small\color{inksoft}#1}}
\newcommand{\hl}[1]{{\color{brick}#1}}
\newcommand{\sectionslide}[2]{%
  \begin{frame}[plain]
    \vfill
    {\color{inksoft}\small\scshape #1}\par\vskip0.3em
    {\color{navy}\huge #2\par}
    \vskip0.6em{\color{rulegrey}\rule{0.35\textwidth}{0.4pt}}
    \vfill
  \end{frame}}

% ---------- code ----------
\lstset{basicstyle=\ttfamily\scriptsize,columns=fullflexible,keepspaces=true,
  keywordstyle=\color{navy}\bfseries,commentstyle=\color{inksoft}\itshape,
  stringstyle=\color{brick},showstringspaces=false,frame=l,framerule=1pt,
  rulecolor=\color{rulegrey},xleftmargin=0.8em,framexleftmargin=0.5em,
  backgroundcolor=\color{white},language=Python,
  literate={×}{{$\times$}}1 {·}{{$\cdot$}}1}

% ---------- plots ----------
\pgfplotsset{srplot/.style={
  axis lines=left, tick label style={font=\scriptsize}, label style={font=\small},
  every axis plot/.append style={line width=1.1pt},
  legend style={draw=none,font=\scriptsize,fill=none},
  axis line style={rulegrey!60!black}, tick style={rulegrey!60!black}}}

% ---------- TikZ styles shared by the RNN/LSTM diagrams ----------
\tikzset{
  cell/.style={draw=navy,line width=0.9pt,rounded corners=2pt,minimum width=1.1cm,minimum height=0.8cm,fill=white},
  io/.style={circle,draw=ink,line width=0.6pt,minimum size=0.62cm,inner sep=0pt,font=\small},
  arr/.style={-{Stealth[length=2.2mm]},line width=0.7pt,color=ink},
  rec/.style={-{Stealth[length=2.2mm]},line width=0.9pt,color=brick},
  gate/.style={circle,draw=ink,fill=white,minimum size=0.5cm,inner sep=0pt,font=\scriptsize},
  op/.style={circle,draw=ink,fill=white,minimum size=0.42cm,inner sep=0pt,font=\small},
}
% ---------- analogy slides ----------
% \analogyframe{title}{the picture, one short paragraph}{rows: everyday & network \\ \pause ...}
\newcommand{\analogyframe}[3]{%
  \begin{frame}{#1}
    {\color{brick}\scriptsize\scshape think of it as\par}\vskip0.25em
    {\itshape\color{ink}#2\par}
    \vskip0.6em
    {\small\renewcommand{\arraystretch}{1.25}%
    \begin{tabular}{@{}>{\raggedright}p{6.0cm}@{\hspace{0.8em}}c@{\hspace{0.8em}}>{\raggedright\arraybackslash}p{6.0cm}@{}}
      {\color{inksoft}\scshape in everyday life} & & {\color{inksoft}\scshape in the network} \\[-0.2em]
      \multicolumn{3}{@{}l@{}}{\color{rulegrey}\rule{\linewidth}{0.4pt}} \\
      #3
    \end{tabular}\par}
  \end{frame}}
\newcommand{\maps}{{\color{brick}$\longrightarrow$}}
% ---------- animation ----------
% Lists build one item per click unless a list says otherwise with [<1->].
\beamerdefaultoverlayspecification{<+->}
% TikZ: [visible on=<2->] keeps the layout but shows the element only from slide 2.
\tikzset{invisible/.style={opacity=0,text opacity=0},
  visible on/.style={alt={#1{}{invisible}}},
  alt/.code args={<#1>#2#3}{\alt<#1>{\pgfkeysalso{#2}}{\pgfkeysalso{#3}}}}
\endinput
